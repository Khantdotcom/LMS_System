// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MENTOR
  ADMIN
}

enum ProgramType {
  Events
  Courses
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique // Real email is now mandatory
  emailVerified DateTime?
  image         String? // Profile picture from Google
  password      String? // Hashed password (optional, only for email signups)
  photoUrl      String?

  // Career Data
  currentPosition String? @map("current_position")
  currentCompany  String? @map("current_company")
  industry        String?

  // Onboarding Logic
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  mentoredEvents      Event[] @relation("MentoredEvents")

  // Telegram Link (Optional now)
  telegramId String? @unique @map("telegram_id")
  xp         Int     @default(0)
  role       Role    @default(USER)

  accounts       Account[] // For NextAuth (Google)
  // ... your existing relations (enrollments, magicLinks etc) ...
  attendedEvents Enrollment[]
  magicLinks     MagicLink[]

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  Event      Event[]
  Attendance Attendance[]

  @@map("users")
}

// Standard NextAuth Model for OAuth
model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Event {
  id           Int     @id @default(autoincrement())
  zoomLink     String  @map("zoom_link")
  zoomPasscode String? @map("zoom_passcode")

  title       String
  date        DateTime
  description String

  mentor   User @relation("MentoredEvents", fields: [mentorId], references: [id])
  mentorId Int  @map("mentor_id")

  attendees Attendance[]

  isPaid Boolean? @default(false)

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  Enrollment Enrollment[]
  User       User?        @relation(fields: [userId], references: [id])
  userId     Int?

  @@map("events")
}

model Attendance {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int   @map("event_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, eventId])
  @@map("attendance")
}

model MagicLink {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("magic_links")
}

// prisma/schema.prisma

model Course {
  id          String @id @default(cuid())
  title       String
  description String
  price       Int
  thumbnail   String // URL to cover image

  // Content
  modules Module[]

  // Who bought it?
  purchases Enrollment[]

  createdAt DateTime @default(now())
}

model Module {
  id       String @id @default(cuid())
  title    String
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  videoUrl String
  order    Int
}

model Enrollment {
  id          String      @id @default(cuid())
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  programType ProgramType @default(Events)
  courseId    String?
  course      Course?     @relation(fields: [courseId], references: [id])

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id])

  status EnrollmentStatus @default(PENDING)

  screenshotUrl String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, eventId])
}
