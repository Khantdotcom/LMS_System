// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MENTOR
  ADMIN
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique // Real email is now mandatory
  emailVerified DateTime?
  image         String? // Profile picture from Google
  password      String? // Hashed password (optional, only for email signups)

  // Career Data
  currentPosition String? @map("current_position")
  currentCompany  String? @map("current_company")
  industry        String?

  // Onboarding Logic
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  mentoredEvents      Event[] @relation("MentoredEvents")

  // Telegram Link (Optional now)
  telegramId String? @unique @map("telegram_id")
  xp         Int     @default(0)
  role       Role    @default(USER)

  accounts       Account[] // For NextAuth (Google)
  // ... your existing relations (enrollments, magicLinks etc) ...
  attendedEvents Enrollment[]
  magicLinks     MagicLink[]

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  Event      Event[]
  Attendance Attendance[]
  Purchase   Purchase[]

  @@map("users")
}

// Standard NextAuth Model for OAuth
model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Event {
  id           Int     @id @default(autoincrement())
  zoomLink     String  @map("zoom_link")
  zoomPasscode String? @map("zoom_passcode")

  title       String
  date        DateTime
  description String

  mentor   User @relation("MentoredEvents", fields: [mentorId], references: [id])
  mentorId Int  @map("mentor_id")

  attendees Attendance[]

  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  Enrollment Enrollment[]
  User       User?        @relation(fields: [userId], references: [id])
  userId     Int?

  @@map("events")
}

model Attendance {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int   @map("event_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, eventId])
  @@map("attendance")
}

model MagicLink {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("magic_links")
}

model Enrollment {
  id Int @id @default(autoincrement())

  // You MUST have these two "Int" lines to save by ID
  userId Int // <--- Make sure this exists!
  user   User @relation(fields: [userId], references: [id])

  eventId Int // <--- Make sure this exists!
  event   Event @relation(fields: [eventId], references: [id])

  screenshotUrl String
  status        String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
}

// prisma/schema.prisma

model Course {
  id          String @id @default(cuid())
  title       String
  description String
  price       Int
  thumbnail   String // URL to cover image

  // Content
  modules Module[]

  // Who bought it?
  purchases Purchase[]

  createdAt DateTime @default(now())
}

model Module {
  id       String @id @default(cuid())
  title    String
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // The Content
  videoUrl String // YouTube Embed URL (e.g. https://www.youtube.com/embed/dQw4w9WgXcQ)
  order    Int // 1, 2, 3
}

model Purchase {
  id     String @id @default(cuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // User buys course only once
}
